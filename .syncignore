# .syncignore — patterns excluded from every upload and download
# One pattern per line. Passed as --exclude to aws s3 sync.
# * matches any character except /  (so *.pkl excludes foo.pkl but not dir/foo.pkl)
# Use */*.pkl or prefix with */ to match in subdirectories.

# OS / editor noise
.DS_Store
*.swp

# Python cache
*.pyc
*/__pycache__/*

# Phase 1: skip large files (temporarily exclude both; remove checkpoint line when ready)
*checkpoints/*
*act_nn_*.npz
